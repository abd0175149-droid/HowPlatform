#--------------------------------------------------------------------
# diploma (CodeIgniter 4) — .env template. Copy to .env on the server
# and fill in real secrets. The real .env is gitignored and mounted
# into the container at runtime. DB host = `db` (the compose service).
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#-------------------------- APP --------------------------
app.baseURL = 'https://diploma.howplatform.net/'

#------------------------ DATABASE -----------------------
database.default.hostname = db
database.default.database = u272058362_BfcXd
database.default.username =
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# auth DB
database.remote.hostname = db
database.remote.database = u272058362_DQLCy
database.remote.username =
database.remote.password =
database.remote.port     = 3306
database.remote.DBDriver = MySQLi

# www DB
database.frontend.hostname = db
database.frontend.database = u272058362_blq0w
database.frontend.username =
database.frontend.password =
database.frontend.DBDriver = MySQLi
database.frontend.port     = 3306

# tools DB
database.tools.hostname = db
database.tools.database = u272058362_eQ6aC
database.tools.username =
database.tools.password =
database.tools.DBDriver = MySQLi
database.tools.port     = 3306

# library DB
database.library.hostname = db
database.library.database = u272058362_IsUw2
database.library.username =
database.library.password =
database.library.DBDriver = MySQLi
database.library.port     = 3306

#----------------------- EMBEDDINGS / AI -----------------
EMBEDDING_PROVIDER = gemini
EMBEDDING_GEMINI_MODEL = embedding-001
EMBEDDING_DIMENSION = 768
AI_GEMINI_API_KEY =
GEMINI_API_KEY =
AI_PROVIDER = gemini
AI_GEMINI_MODEL = gemini-2.5-pro
AI_OPENAI_API_KEY =
AI_OPENAI_MODEL = gpt-5
AI_SAFETY = low
AI_HTTP_TIMEOUT = 500
AI_BUILD_DOCX = 1

#----------------------- ENCRYPTION ----------------------
APP_SECRET_KEY =
RAG_DEBUG_SECRET_KEY =

#------------------------- SESSION -----------------------
session.driver = CodeIgniter\Session\Handlers\DatabaseHandler
session.cookieName = ci_session
session.savePath = ci_sessions
session.expiration = 2592000
session.regenerateDestroy = true
security.maxConcurrentSessions = 2
security.sessionAliveSeconds = 2592000
security.deviceSecret =

#-------------------------- EMAIL ------------------------
EMAIL_FROM      = 'support@howplatform.net'
EMAIL_FROM_NAME = 'منصّة كيف التعليمية'
EMAIL_HOST      = 'smtp.hostinger.com'
EMAIL_USER      = 'support@howplatform.net'
EMAIL_PASS      =
EMAIL_PORT      = 587
EMAIL_CRYPTO    = 'tls'

EMAIL_BROADCAST_HOST = 'smtp.hostinger.com'
EMAIL_BROADCAST_USERNAME = 'support@howplatform.net'
EMAIL_BROADCAST_PASSWORD =
EMAIL_BROADCAST_PORT = 587
EMAIL_BROADCAST_CRYPTO = 'tls'
EMAIL_BROADCAST_FROMEMAIL = 'support@howplatform.net'
EMAIL_BROADCAST_FROMNAME = 'منصّة كيف التعليمية'
EMAIL_BROADCAST_TIMEOUT = 30
EMAIL_BROADCAST_KEEPALIVE = false
EMAIL_BROADCAST_VALIDATE = true

#-------------------------- GOOGLE -----------------------
GOOGLE_CLIENT_ID =
GOOGLE_CLIENT_SECRET =
GOOGLE_REDIRECT_URI = https://diploma.howplatform.net/auth/google-callback
APP_AI_PROXY_TOKEN =

#-------------------------- LIBRARY ----------------------
LIBRARY_API_BASE = https://library.howplatform.net/api
LIBRARY_API_KEY =

#--------------------------- AUTH / JWT ------------------
JWT_SECRET =
JWT_ALGO = HS256
JWT_ISS = auth.howplatform.net
JWT_AUD = howplatform.net
JWT_COOKIE_NAME = howplatform_token
auth.apiUrl = https://auth.howplatform.net/api/user
AUTH_API_URL = https://auth.howplatform.net/api/user

remote.users.baseURL = "https://auth.howplatform.net/api/lookup"
remote.users.apiKey =
remote.users.timeout = 5
remote.users.connectTimeout = 3

#-------------------------- FEATURES ---------------------
FEATURE_UPGRADE_PAGE_MODE = public
FEATURE_UPGRADE_PAGE_ROLLOUT = 100
STUDENT_UPGRADE_UI_ENABLED = true
STUDENT_UPGRADE_ALLOWLIST_IDS =
STUDENT_UPGRADE_ALLOWLIST_EMAILS =
FEATURE_REWARDS_SYSTEM_MODE = public
FEATURE_REWARDS_SYSTEM_ALLOWLIST_IDS =
AI_TOOLS_TEST_USER_IDS =
ARTICLE_EVALUATOR_ALLOWED_USERS =
INQUIRY_PLAN_EVALUATOR_ALLOWED_USERS =

#--------------------------- CRON ------------------------
CRON_SECRET =

#-------------------------- TIMEZONE ---------------------
timezone.display = Asia/Amman

#--------------------------- VERTEX ----------------------
VERTEX_PROJECT_ID = gen-lang-client-0237079010
VERTEX_LOCATION = us-west1
# In Docker the service-account JSON is mounted under /var/www/secure-keys
VERTEX_SERVICE_ACCOUNT_PATH = /var/www/secure-keys/vertex-service-account.json
VERTEX_RAG_CORPUS = projects/gen-lang-client-0237079010/locations/us-west1/ragCorpora/2305843009213693952
VERTEX_RAG_SIMILARITY_TOP_K = 10
VERTEX_RAG_DISTANCE_THRESHOLD = 0.4

APP_NAME=Plans
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://plans.howplatform.net

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_JO
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# قاعدة Plans (المصدر المرجعي للاشتراكات والمحفظة)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=u272058362_Plans1
DB_USERNAME=plans_app
DB_PASSWORD=

# خدمة API بلا حالة — لا حاجة لجداول جلسة/كاش/طابور في قاعدة المحفظة
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=.howplatform.net
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log

# مفاتيح الخدمة الداخلية (X-Api-Key) — مفتاح سرّي لكل منصّة تستدعي Plans
PLANS_KEY_DIPLOMA=
PLANS_KEY_TOOLS=
PLANS_KEY_AUTH=
PLANS_KEY_WWW=
PLANS_KEY_LIBRARY=

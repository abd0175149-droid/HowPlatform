# ===== Laravel on Hostinger: library.howplatform.net =====
# ضع هذا الملف في Document Root الذي يخدم الساب-دومين (public/ أو public_html/ للمكتبة)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1) اجبار HTTPS — لا يفعّل خلف Cloudflare Tunnel (الحافة HTTPS، الأصل HTTP)
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # 2) اسمح بقراءة robots.txt و sitemap.xml مباشرة (مهم لجوجل)
    RewriteCond %{REQUEST_URI} ^/robots\.txt$ [NC,OR]
    RewriteRule ^robots\.txt$ - [L]

    RewriteCond %{REQUEST_URI} ^/sitemap\.xml$ [NC]
    RewriteRule ^ - [L]

    # 3) مرّر الملفات/المجلدات الموجودة كما هي (صور/CSS/JS/الخ)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4) أي شيء آخر → Laravel front controller
    RewriteRule ^ index.php [L]
</IfModule>

# ===== أمان وأداء (قد يلزم تمكين الموديولات من الاستضافة) =====
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS: فعّله فقط إذا كان كل الساب-دومينز على HTTPS. يمكنك حذف includeSubDomains إن لم تكن متأكداً.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/webp "access plus 90 days"
  ExpiresByType image/svg+xml "access plus 90 days"
  ExpiresByType image/png "access plus 90 days"
  ExpiresByType image/jpeg "access plus 90 days"
  ExpiresDefault "access plus 7 days"
</IfModule>
<Files "robots.txt">
  Require all granted
</Files>